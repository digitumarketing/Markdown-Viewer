{
  // Static site plus a small Worker for short share links.
  // Workers Builds runs `npx wrangler deploy` on every push to main.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "markdown-viewer",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // these never match a file, and browsers asking for a page would otherwise
    // get 404.html straight from the assets layer without the Worker running
    "run_worker_first": [
      "/api/*", "/s/*", "/e/*", "/tool", "/tool.html",
      "/markdown-*", "/Markdown-*", "/markmap-*", "/pdf-to-*", "/html-to-*", "/word-to-*",
      "/excel-to-*", "/image-to-*", "/text-to-*", "/paste-to-*", "/discord-*", "/obsidian-*",
      "/github-*", "/mermaid-*", "/tools", "/csv-*", "/json-*", "/table-*", "/epub-*", "/latex-*",
      "/rtf-*", "/chatgpt-*", "/url-*", "/google-*", "/reddit-*", "/podcast-*"
    ]
  },
  // per visitor (IP address) limits for the two endpoints that do real work
  "ratelimits": [
    { "name": "FETCH_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    { "name": "SHARE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "kv_namespaces": [
    { "binding": "SHARES", "id": "6da1a2c5158c4dbf864615e4682c3d7d" }
  ],
  "routes": [
    { "pattern": "markdown.digitum.marketing", "custom_domain": true }
  ]
}
